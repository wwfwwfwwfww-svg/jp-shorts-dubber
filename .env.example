# Copy this file to ".env" and fill in your values.

# ===== 필수 키 2개 =====
# Claude — 1단계(Vision 자막추출)·2단계(일본어)·4단계(메타데이터)에 필요
ANTHROPIC_API_KEY=
# ElevenLabs — 3단계(TTS)에 필요
ELEVENLABS_API_KEY=

# ===== 모델 =====
# vision 지원 모델이어야 합니다. 발급 키가 허용하는 정확한 ID로.
ANTHROPIC_MODEL=claude-sonnet-5
ELEVEN_MODEL=eleven_multilingual_v2
ELEVEN_VOICE_ID=          # 선택(비우면 계정 첫 음성)

# ===== 1단계: 프레임/자막 크롭/콘택트시트 =====
FRAME_INTERVAL=0.5        # 0.5초 간격(fps=2)
CROP_TOP_RATIO=0.4        # 자막 영역 시작 비율(아래쪽, 위치 편차 대비 넉넉히)
CROP_BOTTOM_RATIO=1.0
CONTACT_COLS=4            # 콘택트시트 열
CONTACT_ROWS=4            # 콘택트시트 행 (4x4=16프레임/장)
CONTACT_CELL_W=384        # 셀 폭(px)

# ===== 2단계: 일본어 글자수 예산 =====
NATURAL_CHARS_PER_SEC=6.0   # 자연 발화 속도(초당 글자수, 실측 보정값)
TARGET_SPEED_MIN=1.10       # 예산 목표 배속 범위(대본 분량 산정용)
TARGET_SPEED_MAX=1.18
SPEED_FLOOR=1.0            # 최종 배속 하한(대본이 짧으면 길이 맞추려 여기까지 낮춤)
MAX_CHARS_PER_SEGMENT=26   # 세그먼트당 최대 글자수(13x2줄)

# ===== 3단계: 음량 =====
TARGET_PEAK_DB=-1          # 정규화 목표 피크(dBFS)

# ===== 소재 찾기 탭 (해외 인기 쇼츠 검색·수집) =====
# YouTube Data API v3 키 — 소재 검색에 필요(없으면 소재 찾기 탭만 비활성)
YOUTUBE_API_KEY=
# 저비용 분류/번역용 Claude 모델(카테고리 자동분류·일본 미진출 판별). 더빙 파이프라인은 안 씀.
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# 텔레그램 알림(선택) — 값이 없으면 알림만 비활성, 나머지는 정상 동작
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 검색/수집 기본값 (UI 설정에서 변경 가능; 아래는 최초 기본값)
FINDER_VIEW_FLOOR=3000000          # 조회수 하한(기본 300만)
FINDER_PER_KEYWORD=50              # 키워드당 수집량(최대 100)
FINDER_PERIOD_DAYS=14              # 기본 검색 기간(일)
FINDER_REGIONS=US,GB,CA,AU   # 검색 대상 국가(영어권 위주 — 서구 바이럴 쇼츠). 넓히려면 추가
FINDER_SCAN_HOURS=6                # 레퍼런스 채널 자동 스캔 주기(시간)
FINDER_MORNING_HOUR=7              # 아침 자동수집 시각(0~23)
FINDER_QUOTA_LIMIT=10000           # YouTube Data API 일일 쿼터 한도
FINDER_JAPAN_CHECK_TOP_N=20        # '일본 미진출' 자동 판별 상위 N개
